@page
@model FinalProject.Pages.VideoGames.IndexModel

@{
    ViewData["Title"] = "Video Games";
}

<h1>Video Games</h1>
<img src="/images/game-banner.jpg" alt="Game banner" style="width:100%; max-height: 300px; object-fit: cover; border-radius: 10px;" />

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.VideoGame[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VideoGame[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VideoGame[0].YearPublished)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VideoGame[0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VideoGame[0].Platform)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.VideoGame) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.YearPublished)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Platform.Name)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
